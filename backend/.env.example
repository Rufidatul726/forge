# Local/cloud model configuration. Keep secrets in this ignored file.
ENVIRONMENT=development
# Required for POST /api/v1/generate; generate at least 32 random characters.
FORGE_API_KEY=
# API authentication mode: api_key (default), oidc, or api_key_or_oidc.
AUTH_MODE=api_key
# OIDC issuer and access-token audience used when AUTH_MODE is oidc or api_key_or_oidc.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Optional direct JWKS URL. If unset, Forge discovers it from OIDC_ISSUER.
OIDC_JWKS_URL=
# Optional authorization claims. Scopes are matched from the "scope" claim.
OIDC_REQUIRED_SCOPE=
OIDC_REQUIRED_ROLE=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_MODEL=ollama
# Required for the read-only API agent task endpoint. This path is never client supplied.
AGENT_WORKSPACE_ROOT=
LOG_LEVEL=INFO
# Process-local sliding-window limit for authenticated generation, task, and session routes.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated browser origins allowed to call the development API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
